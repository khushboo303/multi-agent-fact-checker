# Ollama model to use for every agent (must support tool calling for research/adversarial agents)
# Pull it first with: ollama pull llama3.1
OLLAMA_MODEL=llama3.1

# Where Ollama is running (default is fine for a local install)
OLLAMA_BASE_URL=http://localhost:11434

# Max number of search results the search tool returns per query
SEARCH_MAX_RESULTS=5
